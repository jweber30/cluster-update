# /etc/pve/priv/cluster-update-cycle.conf - site settings for cluster-update-cycle.sh,
# shared by every node. Sourced as bash. /etc/pve/priv is root-only, which keeps the
# webhook URL secret. (Fallback: /etc/cluster-update-cycle.conf, chmod 600.)

# Notifications are POSTed here as JSON: {status, message, cycle_id, node, time}
# with status one of info | success | failure. Leave empty to disable.
WEBHOOK_URL="https://my-webhook-url.example.com"

# Guests that must be running on ANOTHER node (and, for VMs, answering guest-agent
# pings) before a node is rebooted. They need to be HA-managed so maintenance mode
# moves them. Example: a router VM.
CRITICAL_SIDS=()
CRITICAL_AGENT_PING=1       # set 0 if a critical VM has no guest agent

# HA guests shut down for the whole cycle and started again at the end. Use this when
# the remaining nodes cannot hold everything while one node is down.
PARK_SIDS=()

# HA VMs moved before maintenance by shutdown + start (ha-manager relocate) instead of
# live migration, e.g. VMs that crash when live-migrated between Intel and AMD nodes.
# Set failback 0 on them, or HA live-migrates them back to a higher-priority node.
RELOCATE_SIDS=()

# Nodes to manage. Empty = every cluster member.
NODES=()

# Timeouts in seconds.
#EVACUATE_TIMEOUT=900       # HA maintenance emptying a node
#REBOOT_TIMEOUT=900         # node coming back after reboot
#HEALTH_TIMEOUT=300         # critical guest health check
#SETTLE_TIMEOUT=900         # HA finishing migrations after a node rejoins
# The two above count only time with no migration running; these bound the rest.
#MIGRATE_MAX_WAIT=21600     # cap on one wait while migrations keep running
#MIGRATE_ATTEMPTS=2         # failed migration tasks of one guest before stopping
#MIN_ROOT_FREE_MB=2048      # free space on / of each other node before evacuating one
#MIN_FREE_MEM_MB=1024       # memory each target keeps free after taking evacuated guests
